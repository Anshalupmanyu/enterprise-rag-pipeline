# =============================================================================
# Enterprise RAG Pipeline - Environment Configuration
# =============================================================================
# Copy this file to .env and customize values for your environment.

# --- LLM Configuration ---
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=mistral
LLM_TEMPERATURE=0.1

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector Store ---
VECTOR_STORE_PATH=./data/vector_store
SIMILARITY_TOP_K=4

# --- Document Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=Enterprise RAG Pipeline
LOG_LEVEL=info
